{
  "expo": {
    "name": "Prayer Journal",
    "slug": "prayer-journal",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prayerjournal",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16121C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prayerjournal.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.prayerjournal.app",
      "adaptiveIcon": {
        "backgroundColor": "#4B1E82",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "owner": "khuphukiles-team",
    "extra": {
      "eas": {
        "projectId": "56dc7063-a5e7-475c-be3e-f40185842d6f"
      }
    }
  }
}
